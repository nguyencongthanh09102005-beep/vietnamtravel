# AI server only (never use VITE_ prefix for secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_MAPS_API_KEY=

# Local development: SQLite is created automatically at .data/vietnamtravel.sqlite
# LOCAL_DB_PATH=.data/vietnamtravel.sqlite

# Online deployment (Vercel): Turso database, REQUIRED for persistent accounts
# Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN in Vercel Environment Variables.
# Example URL: libsql://my-vietnamtravel-db-myorg.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: password reset emails (Resend; requires verified sender domain)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_URL=

# VietnamTravel Admin V1 - server-only authorization.
# Admin email(s) must already have a registered/login account. Comma-separated.
# Put actual address in .env.local on YOUR computer, NOT in GitHub.
ADMIN_EMAILS=

# Independent 32+ character API secrets. Never prefix with VITE_.
CONTENT_REVIEW_SECRET=
CRON_SECRET=

# Optional: legacy catalog to DB read cutover. LEAVE DISABLED until
# an explicitly reviewed and backed-up import of all original cards into
# the correct SQLite/Turso environment is complete.
CONTENT_DB_CANONICAL=0

# Flickr requests may be enabled ONLY after separate commercial API approval.
FLICKR_API_KEY=
FLICKR_API_COMMERCIAL_APPROVED=0

# Local development can disable background source scanning entirely.
# LOCAL_CONTENT_AUTORUN=0
