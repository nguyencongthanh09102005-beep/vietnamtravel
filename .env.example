# AI server only (never use VITE_ prefix for secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_MAPS_API_KEY=

# Local development: SQLite is created automatically at .data/vietnamtravel.sqlite
# LOCAL_DB_PATH=.data/vietnamtravel.sqlite

# Online deployment (Vercel): Turso database, REQUIRED for persistent accounts
# Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN in Vercel Environment Variables.
# Example URL: libsql://my-vietnamtravel-db-myorg.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: password reset emails (Resend; requires verified sender domain)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_URL=
