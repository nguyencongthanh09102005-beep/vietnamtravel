{
  "crons": [
    {
      "path": "/api/content/refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/administration/check",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/worker",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/gateway?__route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
